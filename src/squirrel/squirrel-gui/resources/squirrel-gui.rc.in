// Windows resources for squirrel-gui.exe: application icon and version info.
// Configured by CMake from squirrel-gui.rc.in; edit that file, not the output.

#include <winver.h>

IDI_ICON1 ICON "@SQUIRREL_GUI_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @SQUIRREL_VERSION_YEAR@,@SQUIRREL_VERSION_MONTH@,@SQUIRREL_VERSION_BUILD@,0
PRODUCTVERSION  @SQUIRREL_VERSION_YEAR@,@SQUIRREL_VERSION_MONTH@,@SQUIRREL_VERSION_BUILD@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Olin Neuropsychiatry Research Center"
            VALUE "FileDescription",  "Squirrel"
            VALUE "FileVersion",      "@SQUIRREL_VERSION@"
            VALUE "InternalName",     "squirrel-gui"
            VALUE "LegalCopyright",   "Copyright (C) 2004-@SQUIRREL_VERSION_YEAR@ Gregory A Book. GPLv3."
            VALUE "OriginalFilename", "squirrel-gui.exe"
            VALUE "ProductName",      "Squirrel"
            VALUE "ProductVersion",   "@SQUIRREL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
