[Unit]
Description=DICOM receiver
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
User=nidb
Group=nidb
# bind to port 104 (privileged) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/nidb/bin/dcm4che/bin/dcmrcv NIDB:104 -dest /nidb/data/dicomincoming
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
